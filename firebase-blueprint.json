{
  "entities": {
    "Anime": {
      "title": "Anime",
      "description": "Indian dubbed anime title catalog record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the anime"
        },
        "title": {
          "type": "string",
          "description": "Title of the anime series or movie",
          "maxLength": 200
        },
        "romajiTitle": {
          "type": "string",
          "description": "Romaji or Japanese title",
          "maxLength": 200
        },
        "synopsis": {
          "type": "string",
          "description": "Plot summary and synopsis",
          "maxLength": 4000
        },
        "poster": {
          "type": "string",
          "description": "Poster image URL",
          "maxLength": 1000
        },
        "type": {
          "type": "string",
          "description": "Format (TV, Movie, etc.)"
        },
        "releaseYear": {
          "type": "number",
          "description": "Year of release"
        },
        "rating": {
          "type": "number",
          "description": "Rating score"
        },
        "genres": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of genres"
        },
        "dubs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available dub languages"
        },
        "status": {
          "type": "string",
          "description": "Moderation status (approved, pending, rejected)",
          "enum": ["approved", "pending", "rejected"]
        },
        "airingStatus": {
          "type": "string",
          "description": "Current airing state (Ongoing, Completed)"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reason provided by moderator for rejection",
          "maxLength": 1000
        },
        "likes": {
          "type": "number",
          "description": "Community upvote count"
        },
        "submittedBy": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "userName": { "type": "string" },
            "userEmail": { "type": "string" }
          }
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when submitted"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when last updated"
        }
      },
      "required": ["id", "title", "status"]
    },
    "Watchlist": {
      "title": "Watchlist",
      "description": "User bookmarked anime entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique watchlist item ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID or client fingerprint"
        },
        "animeId": {
          "type": "string",
          "description": "Reference ID of the bookmarked anime"
        },
        "title": {
          "type": "string",
          "description": "Title of the saved anime"
        },
        "poster": {
          "type": "string",
          "description": "Poster image URL"
        },
        "status": {
          "type": "string",
          "description": "Watch status",
          "enum": ["plan_to_watch", "watching", "completed", "dropped"]
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added"
        }
      },
      "required": ["id", "animeId"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback and issue reports",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Feedback ID"
        },
        "nameOrInsta": {
          "type": "string",
          "description": "User identifier or handle",
          "maxLength": 100
        },
        "feedback": {
          "type": "string",
          "description": "Feedback message or report",
          "maxLength": 2000
        },
        "rating": {
          "type": "number",
          "description": "Rating out of 5"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Feedback submission timestamp"
        }
      },
      "required": ["id", "feedback"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Live user interaction event for real-time feed",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Activity event ID"
        },
        "user": {
          "type": "string",
          "description": "User display name"
        },
        "action": {
          "type": "string",
          "description": "Action performed",
          "enum": ["watchlisted", "reviewed", "searched", "streamed", "submitted", "updated", "approved", "feedback"]
        },
        "animeTitle": {
          "type": "string",
          "description": "Anime title associated with action"
        },
        "language": {
          "type": "string",
          "description": "Dub language involved"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Time of event"
        }
      },
      "required": ["id", "user", "action"]
    },
    "AnalyticsRealtime": {
      "title": "AnalyticsRealtime",
      "description": "Aggregated real-time metrics for admin dashboard",
      "type": "object",
      "properties": {
        "activeUsers": {
          "type": "number",
          "description": "Current active user count"
        },
        "totalWatchlists": {
          "type": "number",
          "description": "Total saved watchlists count"
        },
        "dubStreams": {
          "type": "number",
          "description": "Total dub streams count"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last metric calculation"
        }
      },
      "required": ["lastUpdated"]
    }
  },
  "firestore": {
    "/anime_list/{animeId}": {
      "schema": "Anime",
      "description": "Collection of all published and pending anime dub records"
    },
    "/watchlists/{watchlistId}": {
      "schema": "Watchlist",
      "description": "Collection of user-saved watchlists"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Collection of community feedback submissions"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Real-time feed activity items"
    },
    "/analytics/{docId}": {
      "schema": "AnalyticsRealtime",
      "description": "Real-time statistics document"
    }
  }
}
