# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IMGBB_API_KEY: Server-side API key for ImgBB image uploads (/api/upload).
# Used exclusively on the backend (process.env.IMGBB_API_KEY).
# Never expose this key on the client side.
IMGBB_API_KEY="YOUR_IMGBB_API_KEY"

# CLERK AUTHENTICATION & ADMIN SECURITY:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"
VITE_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"
CLERK_JWT_KEY=""
ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
NEXT_PUBLIC_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
VITE_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"

# Telegram Bot Notifications (One-way notifications for new anime)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Cloudflare Backend Configuration (Workers + D1 / KV)
# Set your deployed Cloudflare Worker or Pages URL here.
# When empty or omitted, requests default to the same-origin '/api' proxy.
VITE_CLOUDFLARE_API_URL="https://anidub-catalog-worker.your-subdomain.workers.dev"

# OMDB_API_KEY: Secret API key for OMDb API (IMDb ratings).
# Used exclusively on the backend via /api/omdb proxy.
# Get your free key from https://www.omdbapi.com/
OMDB_API_KEY="YOUR_OMDB_API_KEY"

# VITE_OMDB_API_KEY: Placeholder for reference, not used directly by client code due to proxy security.
VITE_OMDB_API_KEY="YOUR_OMDB_API_KEY"
